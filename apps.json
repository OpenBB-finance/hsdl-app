[
    {
        "name": "HSDL Document Explorer",
        "img": "https://www.hsdl.org/c/resources/uploads/2022/08/card-library.jpg",
        "img_dark": "https://www.hsdl.org/c/resources/uploads/2022/08/card-library.jpg",
        "img_light": "https://www.hsdl.org/c/resources/uploads/2022/08/card-library.jpg",
        "description": "Search, explore, and view the public collection of documents in the Homeland Security Digital Library.",
        "allowCustomization": true,
        "tabs": {
            "main": {
                "id": "main",
                "name": "main",
                "layout": [
                    {
                        "i": "hsdl_document_search",
                        "x": 0,
                        "y": 0,
                        "w": 40,
                        "h": 10,
                        "state": {
                            "params": {},
                            "chartView": {
                                "enabled": false,
                                "chartType": "line"
                            },
                            "columnState": {
                                "default": {
                                    "columnPinning": {
                                        "leftColIds": [
                                            "docid"
                                        ],
                                        "rightColIds": []
                                    }
                                }
                            }
                        },
                        "groups": [
                            "Resource Group",
                            "Year",
                            "Subject",
                            "Publisher"
                        ]
                    },
                    {
                        "i": "hsdl_document_viewer",
                        "x": 0,
                        "y": 10,
                        "w": 40,
                        "h": 28,
                        "state": {
                            "params": {}
                        },
                        "groups": [
                            "Resource Group",
                            "Year",
                            "Subject",
                            "Publisher"
                        ]
                    }
                ]
            }
        },
        "groups": [
            {
                "name": "Resource Group",
                "type": "endpointParam",
                "paramName": "resource_group",
                "defaultValue": "all"
            },
            {
                "name": "Year",
                "type": "endpointParam",
                "paramName": "year",
                "defaultValue": "2026"
            },
            {
                "name": "Subject",
                "type": "endpointParam",
                "paramName": "subject",
                "defaultValue": "all"
            },
            {
                "name": "Publisher",
                "type": "endpointParam",
                "paramName": "publisher",
                "defaultValue": "all"
            }
        ]
    }
]